<?xml version="1.0"?>
<Container version="2">
  <Name>XP2AIOM</Name>
  <Repository>ghcr.io/mckenna654/xp2aiom:latest</Repository>
  <Registry>https://github.com/mckenna654/xp2aiom/pkgs/container/xp2aiom</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/mckenna654/xp2aiom/issues</Support>
  <Project>https://github.com/mckenna654/xp2aiom</Project>
  <Overview>
    Nuvio / Xperience ➔ AIOMetadata Bridge
    
    Self-hosted WebGUI application that connects to your Nuvio/Xperience account or imports widget/manifest JSON exports and converts them into 1-click importable AIOMetadata catalog configurations for Stremio.
  </Overview>
  <Category>MediaApp:Video MediaServer:Other Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/mckenna654/xp2aiom/main/unraid-template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/mckenna654/xp2aiom/main/app/static/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Description>
    Self-hosted bridge connecting Nuvio/Xperience layouts to AIOMetadata.
  </Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>8080</HostPort>
        <ContainerPort>8080</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir/>
      <ContainerDir/>
      <Mode/>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Value>8080</Value>
      <Name>PORT</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>0.0.0.0</Value>
      <Name>HOST</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Labels/>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Port for the XP2AIOM Web UI" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
</Container>
